# Zkopírujte jako .env a doplňte svoje údaje k Raynetu (.env je v .gitignore).
# Schválně bez prefixu VITE_, čte je jen dev server, do prohlížeče se nedostanou.

# e-mail, kterým se přihlašujete do Raynetu
RAYNET_USERNAME=vas@email.cz

# API klíč (vygenerujete ho v Raynetu v nastavení svého účtu)
RAYNET_API_KEY=vas-api-klic

# název instance z adresy, např. app.raynet.cz/moje-firma/ -> moje-firma
RAYNET_INSTANCE=nazev-instance
